APP_ENV=development
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
APP_TIME_ZONE=America/Argentina/Buenos_Aires

# Development database. Replace blank credentials locally.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=turnos_odontologia
DATABASE_USER=
DATABASE_PASSWORD=

# Minimum 32 characters. Never reuse a production secret.
AUTH_SECRET=

# Optional for normal startup; required by npm run provision:admin.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Separate MariaDB database used only by integration tests.
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=3306
TEST_DATABASE_NAME=turnos_odontologia_test
TEST_DATABASE_USER=
TEST_DATABASE_PASSWORD=
